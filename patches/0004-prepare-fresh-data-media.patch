+bool TWPartition::Prepare_Fresh_Data_Media() {
+	// A successful /data mount alone does not mean that existing FBE files
+	// are unlocked. Accept only the small layout left by a fresh format.
+	if (Mount_Point != "/data" || !Has_Data_Media || Key_Directory.empty() ||
+			Mount_Read_Only || !Mount(false))
+		return false;
+
+	struct statfs fs;
+	if (statfs(Mount_Point.c_str(), &fs) != 0 || (fs.f_flags & MS_RDONLY) ||
+			(fs.f_type != 0xEF53 && fs.f_type != 0xF2F52010))
+		return false; // Never create storage on a tmpfs or an unmounted /data.
+
+	DIR* directory = opendir(Mount_Point.c_str());
+	if (!directory)
+		return false;
+	bool fresh = true;
+	struct dirent* entry;
+	while ((errno = 0, entry = readdir(directory)) != nullptr) {
+		const string name = entry->d_name;
+		if (name == "." || name == "..")
+			continue;
+		struct stat info;
+		if ((name != "lost+found" && name != "recovery" && name != "media") ||
+				lstat((Mount_Point + "/" + name).c_str(), &info) != 0 || !S_ISDIR(info.st_mode)) {
+			fresh = false;
+			break;
+		}
+	}
+	const int scan_error = errno;
+	closedir(directory);
+	if (!fresh || scan_error)
+		return false; // Includes unencrypted/key, misc/vold keys and user directories.
+
+	const string media = Mount_Point + "/media";
+	struct stat info;
+	if (lstat((media + "/0").c_str(), &info) == 0 || errno != ENOENT)
+		return false; // Android must create user 0 and its CE encryption policy.
+
+	bool created = false;
+	if (lstat(media.c_str(), &info) != 0) {
+		if (errno != ENOENT || mkdir(media.c_str(), 0770) != 0)
+			return false;
+		created = true;
+	}
+	const int fd = open(media.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return false;
+	int attributes = 0;
+	const bool plain = ioctl(fd, FS_IOC_GETFLAGS, &attributes) == 0 && !(attributes & FS_ENCRYPT_FL);
+	close(fd);
+	if (!plain)
+		return false; // Fail closed if media itself has an encryption policy.
+
+	if (created) {
+		// Apply the file_contexts label, without borrowing an old user-0 policy.
+		char* context = nullptr;
+		if (selinux_handle && selabel_lookup(selinux_handle, &context, media.c_str(), S_IFDIR) == 0) {
+			const int result = lsetfilecon(media.c_str(), context);
+			freecon(context);
+			if (result != 0)
+				return false;
+		}
+	}
+	if (chown(media.c_str(), 1023, 1023) != 0 || chmod(media.c_str(), 0770) != 0)
+		return false;
+
+	Setup_Data_Media();
+	// Setup_Data_Media selects /data/media because no user-0 directory exists.
+	// Mount() returns early for an already mounted /data, so bind explicitly.
+	if (umount2(Symlink_Mount_Point.c_str(), 0) != 0 && errno != EINVAL && errno != ENOENT)
+		return false;
+	if (!Bind_Mount(false))
+		return false;
+
+	Is_FBE = false; // No FBE users/keys exist yet; retain the metadata mapping.
+	Is_Encrypted = false;
+	Is_Decrypted = true;
+	DataManager::SetValue(TW_IS_FBE, 0);
+	DataManager::SetValue(TW_IS_ENCRYPTED, 0);
+	DataManager::SetValue(TW_IS_DECRYPTED, 1);
+	DataManager::SetValue(TW_CRYPTO_PWTYPE, 0);
+	DataManager::SetValue("tw_crypto_pwtype_0", 0);
+	DataManager::SetValue(TW_INTERNAL_PATH, Storage_Path);
+	DataManager::SetValue("tw_storage_path", Storage_Path);
+	DataManager::SetValue("tw_settings_path", Storage_Path);
+	PartitionManager.Add_MTP_Storage(MTP_Storage_ID); // Only adds if MTP is already enabled.
+	LOGINFO("Fresh userdata: prepared /data/media staging storage; Android will initialize FBE users.\n");
+	return true;
 }
 
